<UserControl x:Class="WorkNotes.Controls.EppInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Margin="4,2"
                   Foreground="{DynamicResource App.TextSecondary}" FontSize="12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">
                <ItemsControl x:Name="FieldsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.TextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           Foreground="{DynamicResource App.TextPrimary}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="UnknownHeader" Text="Unrecognized extensions (shown as opaque — not interpreted):"
                           FontWeight="SemiBold" Margin="0,10,0,2" Visibility="Collapsed"
                           Foreground="{DynamicResource App.TextSecondary}"/>
                <ItemsControl x:Name="UnknownList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{DynamicResource App.TextSecondary}" Margin="12,1,0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="BusyOverlay" Grid.Row="1" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Inspecting EPP…" Foreground="{DynamicResource App.TextPrimary}" Margin="0,0,0,8"/>
            <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
            <Button Content="Cancel" Margin="0,10,0,0" Padding="14,4"
                    HorizontalAlignment="Center" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
