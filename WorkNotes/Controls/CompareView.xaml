<UserControl x:Class="WorkNotes.Controls.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ListBox x:Name="DiffList"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Row" Padding="6,1">
                        <TextBlock Text="{Binding Text}"
                                   TextWrapping="NoWrap"
                                   Foreground="{DynamicResource App.TextPrimary}"/>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                            <Setter TargetName="Row" Property="Background" Value="#33FF5555"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                            <Setter TargetName="Row" Property="Background" Value="#3355BB55"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Busy/cancel state while the diff runs off the UI thread -->
        <StackPanel x:Name="BusyOverlay"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Comparing…" Foreground="{DynamicResource App.TextPrimary}" Margin="0,0,0,8"/>
            <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
            <Button Content="Cancel" Margin="0,10,0,0" Padding="14,4"
                    HorizontalAlignment="Center" Click="CancelCompare_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
