<UserControl x:Class="WorkNotes.Controls.EditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <UserControl.Resources>
        <!-- Context Menu for Source Editor -->
        <ContextMenu x:Key="SourceEditorContextMenu">
            <MenuItem Header="Undo" 
                      Click="ContextUndo_Click" 
                      InputGestureText="Ctrl+Z"/>
            <MenuItem Header="Redo" 
                      Click="ContextRedo_Click" 
                      InputGestureText="Ctrl+Y"/>
            <Separator/>
            <MenuItem Header="Cut" 
                      Click="ContextCut_Click" 
                      InputGestureText="Ctrl+X"/>
            <MenuItem Header="Copy" 
                      Click="ContextCopy_Click" 
                      InputGestureText="Ctrl+C"/>
            <MenuItem Header="Paste" 
                      Click="ContextPaste_Click" 
                      InputGestureText="Ctrl+V"/>
            <Separator/>
            <MenuItem Header="Select All" 
                      Click="ContextSelectAll_Click" 
                      InputGestureText="Ctrl+A"/>
            <Separator/>
            <MenuItem Header="Bold" 
                      Click="ContextBold_Click" 
                      InputGestureText="Ctrl+B"/>
            <MenuItem Header="Italic" 
                      Click="ContextItalic_Click" 
                      InputGestureText="Ctrl+I"/>
            <MenuItem Header="Insert Link" 
                      Click="ContextInsertLink_Click" 
                      InputGestureText="Ctrl+K"/>
        </ContextMenu>
        
        <!-- Context Menu for Formatted Editor -->
        <ContextMenu x:Key="FormattedEditorContextMenu">
            <MenuItem Header="Undo" 
                      Click="ContextUndo_Click" 
                      InputGestureText="Ctrl+Z"/>
            <MenuItem Header="Redo" 
                      Click="ContextRedo_Click" 
                      InputGestureText="Ctrl+Y"/>
            <Separator/>
            <MenuItem Header="Cut" 
                      Click="ContextCut_Click" 
                      InputGestureText="Ctrl+X"/>
            <MenuItem Header="Copy" 
                      Click="ContextCopy_Click" 
                      InputGestureText="Ctrl+C"/>
            <MenuItem Header="Paste" 
                      Click="ContextPaste_Click" 
                      InputGestureText="Ctrl+V"/>
            <Separator/>
            <MenuItem Header="Select All" 
                      Click="ContextSelectAll_Click" 
                      InputGestureText="Ctrl+A"/>
            <Separator/>
            <MenuItem Header="Bold" 
                      Click="ContextBold_Click" 
                      InputGestureText="Ctrl+B"/>
            <MenuItem Header="Italic" 
                      Click="ContextItalic_Click" 
                      InputGestureText="Ctrl+I"/>
            <MenuItem Header="Insert Link" 
                      Click="ContextInsertLink_Click" 
                      InputGestureText="Ctrl+K"/>
        </ContextMenu>
    </UserControl.Resources>
    
    <Grid>
        <!-- Source View (raw Markdown) -->
        <avalonedit:TextEditor x:Name="SourceEditor"
                               Background="{DynamicResource App.EditorBackground}"
                               Foreground="{DynamicResource App.EditorForeground}"
                               LineNumbersForeground="{DynamicResource App.EditorLineNumbersForeground}"
                               FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                               FontSize="15"
                               ShowLineNumbers="True"
                               Padding="52,36,52,40"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Auto"
                               WordWrap="False"
                               ContextMenu="{StaticResource SourceEditorContextMenu}"
                               Visibility="Collapsed">
        </avalonedit:TextEditor>

        <!-- Formatted View (rendered Markdown) -->
        <RichTextBox x:Name="FormattedEditor"
                     Background="{DynamicResource App.EditorBackground}"
                     Foreground="{DynamicResource App.EditorForeground}"
                     BorderThickness="0"
                     CaretBrush="{DynamicResource App.Accent}"
                     SelectionBrush="{DynamicResource App.EditorSelection}"
                     SelectionOpacity="0.85"
                     FontFamily="Segoe UI Variable Text, Segoe UI"
                     FontSize="15.5"
                     Padding="52,36,52,40"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     IsDocumentEnabled="True"
                     SpellCheck.IsEnabled="True"
                     Language="en-US"
                     ContextMenu="{StaticResource FormattedEditorContextMenu}"
                     Visibility="Visible">
            <RichTextBox.Document>
                <FlowDocument LineHeight="26" LineStackingStrategy="BlockLineHeight"/>
            </RichTextBox.Document>
        </RichTextBox>

        <!-- Empty state.
             Declared LAST so it paints above the editors: both editors have an opaque
             background, so a placeholder behind them can never be seen. It is only
             visible while the document is empty and never takes hit-tests, so drawing
             it on top is safe. -->
        <Border x:Name="EmptyStatePlaceholder"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,-64,0,0"
                Padding="34,28"
                Background="{DynamicResource App.Surface}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1"
                CornerRadius="18"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="28"
                                  ShadowDepth="6"
                                  Opacity="0.28"
                                  Direction="270"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <Border Width="46" Height="46"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource App.AccentGradient}"
                        CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource App.AccentColor}"
                                          BlurRadius="18"
                                          ShadowDepth="0"
                                          Opacity="0.5"/>
                    </Border.Effect>
                    <Path Data="M10,8 L26,8 L26,30 L10,30 Z M14,14 L22,14 M14,19 L22,19 M14,24 L20,24"
                          Stroke="{DynamicResource App.AccentText}"
                          StrokeThickness="1.8"
                          Fill="Transparent"
                          Stretch="Uniform"
                          Width="22" Height="22"/>
                </Border>
                <TextBlock Text="Start with a thought"
                           Margin="0,16,0,0"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextPrimary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Write naturally, paste a link, or drop a note here."
                           Margin="0,7,0,0"
                           FontSize="12.5"
                           Foreground="{DynamicResource App.TextSecondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
