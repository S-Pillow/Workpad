<UserControl x:Class="WorkNotes.Controls.SplitViewContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WorkNotes.Controls">
    <Grid Background="{DynamicResource App.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="220"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="220"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="0,0,0,1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PANE A" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Accent}"/>
                        <TextBlock x:Name="TopFileName" Text="Untitled" Margin="0,2,8,0"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open" Click="OpenTop_Click"
                            Padding="10,5" Margin="0,0,6,0" ToolTip="Open a file in Pane A"/>
                    <CheckBox x:Name="TopReadOnly" Grid.Column="2" Content="Reference"
                              IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="TopReadOnly_Changed" Unchecked="TopReadOnly_Changed"
                              ToolTip="Keep this pane read-only"/>
                    <Button Grid.Column="3" Content="×" Click="CloseTop_Click"
                            Width="30" Height="30" Padding="0" FontSize="18" ToolTip="Close Pane A"/>
                </Grid>
            </Border>
            <controls:EditorPane x:Name="TopPane" Grid.Row="1" PaneId="A"/>
        </Grid>

        <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="{DynamicResource App.Surface2}"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="0,0,0,1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PANE B" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.Accent}"/>
                        <TextBlock x:Name="BottomFileName" Text="Untitled" Margin="0,2,8,0"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open" Click="OpenBottom_Click"
                            Padding="10,5" Margin="0,0,6,0" ToolTip="Open a file in Pane B"/>
                    <CheckBox x:Name="BottomReadOnly" Grid.Column="2" Content="Reference"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="BottomReadOnly_Changed" Unchecked="BottomReadOnly_Changed"
                              ToolTip="Keep this pane read-only"/>
                    <Button Grid.Column="3" Content="×" Click="CloseBottom_Click"
                            Width="30" Height="30" Padding="0" FontSize="18" ToolTip="Close Pane B"/>
                </Grid>
            </Border>
            <controls:EditorPane x:Name="BottomPane" Grid.Row="1" PaneId="B"/>
        </Grid>
    </Grid>
</UserControl>
