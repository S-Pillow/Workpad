<Window x:Class="WorkNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorkNotes.Controls"
        xmlns:converters="clr-namespace:WorkNotes.Converters"
        Title="Work Notes" 
        Height="680"
        Width="1040"
        MinHeight="520"
        MinWidth="720"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0,1,0,0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{DynamicResource App.Background}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header shell -->
                <RowDefinition Height="*"/>    <!-- Tabs + content -->
                <RowDefinition Height="Auto"/> <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ═══════ HEADER SHELL ═══════ -->
            <!-- One unified surface for title bar, menu, and toolbar.
                 Hidden in FullScreen, PostIt, and DistractionFree modes via ViewModeManager binding. -->
            <Grid Grid.Row="0" Background="{DynamicResource App.SurfaceGradient}"
                  Visibility="{Binding ViewModeManager.IsHeaderVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>   <!-- Title bar -->
                    <RowDefinition Height="Auto"/> <!-- Menu bar -->
                    <RowDefinition Height="Auto"/> <!-- Toolbar -->
                </Grid.RowDefinitions>

                <!-- Title bar (unified with header surface) -->
                <Grid Grid.Row="0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- Icon + title -->
                        <ColumnDefinition Width="*"/>     <!-- Spacer (draggable) -->
                        <ColumnDefinition Width="Auto"/>  <!-- Caption buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- App icon + title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <!-- Identity mark: the one place the full accent gradient appears at
                             rest, so the app has a recognisable signature in the taskbar row. -->
                        <Border Width="26" Height="26" Margin="0,0,10,0"
                                Background="{DynamicResource App.AccentGradient}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource App.AccentColor}"
                                                  BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.45"/>
                            </Border.Effect>
                            <Path Data="M6,6 L18,6 L18,18 L6,18 Z M6,10 L18,10 M10,10 L10,18"
                                  Stroke="{DynamicResource App.AccentText}"
                                  StrokeThickness="1.6"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  Width="14" Height="14"/>
                        </Border>
                        <TextBlock x:Name="TitleBarText"
                                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{DynamicResource App.TitleBarForeground}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Caption buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <Path Data="M 0,0 L 10,0"
                                  Stroke="{DynamicResource App.CaptionButtonForeground}"
                                  StrokeThickness="1"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="10" Height="1"
                                  Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize">
                            <Path x:Name="MaximizeIcon"
                                  Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                                  Stroke="{DynamicResource App.CaptionButtonForeground}"
                                  StrokeThickness="1"
                                  Fill="Transparent"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="10" Height="10"
                                  Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CaptionCloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Close"/>
                    </StackPanel>
                </Grid>

                <!-- Menu bar (transparent, floats on the shared surface) -->
                <Menu Grid.Row="1">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New Tab" 
                                  Click="New_Click" 
                                  InputGestureText="Ctrl+T"/>
                        <MenuItem Header="_Open..." 
                                  Click="Open_Click" 
                                  InputGestureText="Ctrl+O"/>
                        <MenuItem Header="_Save" 
                                  Click="Save_Click" 
                                  InputGestureText="Ctrl+S"/>
                        <MenuItem Header="Save _As..." 
                                  Click="SaveAs_Click" 
                                  InputGestureText="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem Header="_Recent Files" 
                                  x:Name="RecentFilesMenu">
                            <MenuItem Header="(No recent files)" 
                                      IsEnabled="False"
                                      x:Name="NoRecentFilesPlaceholder"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="_Close Tab" 
                                  Click="CloseTab_Click" 
                                  InputGestureText="Ctrl+W"/>
                        <MenuItem Header="Reopen Closed Tab" 
                                  Click="ReopenClosedTab_Click" 
                                  InputGestureText="Ctrl+Shift+T"
                                  x:Name="ReopenClosedTabMenu"/>
                        <Separator/>
                        <MenuItem Header="E_xit" 
                                  Click="Exit_Click" 
                                  InputGestureText="Alt+F4"/>
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" 
                                  Click="Undo_Click" 
                                  InputGestureText="Ctrl+Z"/>
                        <MenuItem Header="_Redo" 
                                  Click="Redo_Click" 
                                  InputGestureText="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem Header="Cu_t" 
                                  Click="Cut_Click" 
                                  InputGestureText="Ctrl+X"/>
                        <MenuItem Header="_Copy" 
                                  Click="Copy_Click" 
                                  InputGestureText="Ctrl+C"/>
                        <MenuItem Header="_Paste" 
                                  Click="Paste_Click" 
                                  InputGestureText="Ctrl+V"/>
                        <Separator/>
                        <MenuItem Header="_Find..." 
                                  Click="Find_Click" 
                                  InputGestureText="Ctrl+F"/>
                        <MenuItem Header="_Replace..." 
                                  Click="Replace_Click" 
                                  InputGestureText="Ctrl+H"/>
                        <MenuItem Header="_Go to line..."
                                  Click="LineColButton_Click"
                                  InputGestureText="Ctrl+G"/>
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="_Formatted View" 
                                  Click="ViewFormatted_Click"
                                  IsCheckable="True"
                                  x:Name="MenuViewFormatted"/>
                        <MenuItem Header="_Markdown Source" 
                                  Click="ViewSource_Click"
                                  IsCheckable="True"
                                  x:Name="MenuViewSource"/>
                        <Separator/>
                        <MenuItem Header="Toggle View Mode"
                                  Click="ViewModeToggle_Click"
                                  InputGestureText="Ctrl+Shift+M"/>
                        <Separator/>
                        <MenuItem Header="_Full Screen"
                                  Command="{Binding ViewModeManager.ToggleFullScreenCommand}"
                                  InputGestureText="F11"
                                  x:Name="MenuFullScreen"/>
                        <MenuItem Header="_Post-It Mode"
                                  Command="{Binding ViewModeManager.TogglePostItCommand}"
                                  InputGestureText="F12"
                                  x:Name="MenuPostIt"/>
                        <MenuItem Header="_Distraction Free"
                                  Command="{Binding ViewModeManager.ToggleDistractionFreeCommand}"
                                  InputGestureText="Ctrl+Shift+F"
                                  x:Name="MenuDistractionFree"/>
                        <Separator/>
                        <MenuItem Header="Always On _Top"
                                  IsCheckable="True"
                                  IsChecked="{Binding ViewModeManager.IsAlwaysOnTop, Mode=TwoWay}"
                                  x:Name="MenuAlwaysOnTop"/>
                        <Separator/>
                        <MenuItem Header="_Split View"
                                  Click="SplitView_Click"
                                  IsCheckable="True"
                                  x:Name="MenuSplitView">
                            <MenuItem.ToolTip>
                                <TextBlock Foreground="{DynamicResource App.TooltipForeground}">
                                    <Run Text="Open two independent documents side by side"/>
                                    <LineBreak/>
                                    <Run Text="Two independent documents" FontStyle="Italic"/>
                                </TextBlock>
                            </MenuItem.ToolTip>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="_Bionic Reading"
                                  Click="BionicReading_Click"
                                  IsCheckable="True"
                                  x:Name="MenuBionicReading"/>
                    </MenuItem>
                    <MenuItem Header="F_ormat">
                        <MenuItem Header="_Bold" 
                                  Click="Bold_Click" 
                                  InputGestureText="Ctrl+B"/>
                        <MenuItem Header="_Italic" 
                                  Click="Italic_Click" 
                                  InputGestureText="Ctrl+I"/>
                        <MenuItem Header="Insert _Link" 
                                  Click="InsertLink_Click" 
                                  InputGestureText="Ctrl+K"/>
                    </MenuItem>
                    <MenuItem Header="_Settings">
                        <MenuItem Header="_Preferences..."
                                  Click="Preferences_Click"/>
                    </MenuItem>
                </Menu>

                <!-- Toolbar (overflow-aware, minimal chrome) -->
                <ScrollViewer Grid.Row="2" 
                              Style="{StaticResource ToolbarScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled"
                              Margin="8,2,8,8"
                              Padding="0">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <!-- Toolbar is grouped into segmented pills: related actions share a
                             raised container so the eye parses File / Format / View as three
                             clusters instead of eight loose glyphs. -->
                        <Border Background="{DynamicResource App.Surface2}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="3"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                        <!-- File Actions -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Click="New_Click"
                                ToolTip="New tab (Ctrl+T)">
                            <Path Data="M3,2 L11,2 L14,5 L14,14 L3,14 Z M11,2 L11,5 L14,5 M8.5,7 L8.5,12 M6,9.5 L11,9.5"
                                  Stroke="{DynamicResource App.IconPrimary}"
                                  StrokeThickness="1.35"
                                  Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Click="Open_Click"
                                ToolTip="Open (Ctrl+O)">
                            <Path Data="M2,5 L7,5 L8.5,3 L14,3 L14,13 L2,13 Z M2,7 L14,7"
                                  Stroke="{DynamicResource App.IconPrimary}"
                                  StrokeThickness="1.35"
                                  Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Click="Save_Click"
                                ToolTip="Save (Ctrl+S)">
                            <Path Data="M3,2 L12,2 L14,4 L14,14 L2,14 L2,2 Z M5,2 L5,6 L11,6 L11,2 M5,10 L11,10 L11,14 L5,14 Z"
                                  Stroke="{DynamicResource App.IconPrimary}"
                                  StrokeThickness="1.35"
                                  Fill="Transparent"/>
                        </Button>

                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource App.Surface2}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="3"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                        <!-- Formatting Actions -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Click="Bold_Click"
                                ToolTip="Bold (Ctrl+B)">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M4,2 L4,14 M4,2 L10,2 C11.5,2 12.5,3 12.5,4.5 C12.5,5.5 12,6.5 10.5,7 C12.5,7.5 13.5,8.5 13.5,10.5 C13.5,12.5 12,14 10,14 L4,14 M4,7 L10.5,7 M4,2 L10,2 M4,14 L10,14"
                                          Stroke="{DynamicResource App.IconPrimary}"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Click="Italic_Click"
                                ToolTip="Italic (Ctrl+I)">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M6,2 L12,2 M4,14 L10,14 M9,2 L7,14"
                                          Stroke="{DynamicResource App.IconPrimary}"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Click="InsertLink_Click"
                                ToolTip="Insert Link (Ctrl+K)">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M7,9 L9,7 M4,6 L6,4 C7.5,2.5 9.5,2.5 11,4 C12.5,5.5 12.5,7.5 11,9 L9,11 M5,12 L7,10 C5.5,11.5 3.5,11.5 2,10 C0.5,8.5 0.5,6.5 2,5 L4,3"
                                          Stroke="{DynamicResource App.IconPrimary}"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource App.Surface2}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="3">
                            <StackPanel Orientation="Horizontal">
                        <!-- View Actions -->
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Click="SplitView_Click">
                            <Button.ToolTip>
                                <TextBlock Foreground="{DynamicResource App.TooltipForeground}">
                                    <Run Text="Split View"/>
                                    <LineBreak/>
                                    <Run Text="Two independent documents" FontStyle="Italic" FontSize="10"/>
                                </TextBlock>
                            </Button.ToolTip>
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="2" Canvas.Top="2" Width="5" Height="12"
                                              Stroke="{DynamicResource App.IconPrimary}"
                                              StrokeThickness="1.5"
                                              Fill="Transparent"/>
                                    <Rectangle Canvas.Left="9" Canvas.Top="2" Width="5" Height="12"
                                              Stroke="{DynamicResource App.IconPrimary}"
                                              StrokeThickness="1.5"
                                              Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Click="Find_Click"
                                ToolTip="Find (Ctrl+F)">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="16" Height="16">
                                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="9" Height="9"
                                             Stroke="{DynamicResource App.IconPrimary}"
                                             StrokeThickness="1.5"/>
                                    <Path Data="M10,10 L14,14"
                                          Stroke="{DynamicResource App.IconPrimary}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══════ TAB CONTROL + CONTENT ═══════ -->
            <!-- Grid overlay: TabControl + exit-mode button layered on top -->
            <Grid Grid.Row="1">
                <!-- Distraction-free reading-width wrapper: adds horizontal padding to center content -->
                <Border Padding="{Binding ViewModeManager.DistractionFreePadding}">
                    <TabControl x:Name="TabControl"
                                SelectionChanged="TabControl_SelectionChanged"
                                Background="{DynamicResource App.Background}"
                                BorderThickness="0"
                                BorderBrush="{DynamicResource App.Border}"
                                Tag="{Binding ViewModeManager}">
                    </TabControl>
                </Border>

                <!-- Exit mode overlay button (top-right, above content) -->
                <Button x:Name="ExitModeButton"
                        Style="{DynamicResource ExitModeButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,12,0"
                        Panel.ZIndex="100"
                        Visibility="{Binding ViewModeManager.IsExitButtonVisible, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ViewModeManager.ExitToNormalCommand}"
                        ToolTip="Return to normal view (Esc)">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 0,0 L 6,6 M 6,0 L 0,6"
                              Stroke="{DynamicResource App.IconPrimary}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="8" Height="8"
                              Stretch="Uniform"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ViewModeManager.ExitModeLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource App.TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ═══════ STATUS BAR ═══════ -->
            <StatusBar Grid.Row="2"
                       Visibility="{Binding ViewModeManager.IsStatusBarVisible, Converter={StaticResource BoolToVis}}">
                <!-- Left: document readouts, each a chip so the footer reads as controls -->
                <StatusBarItem Padding="0">
                    <StackPanel Orientation="Horizontal">

                        <!-- View mode toggle -->
                        <Button x:Name="ViewModeToggle"
                                Style="{StaticResource StatusChipButtonStyle}"
                                Click="ViewModeToggle_Click"
                                ToolTip="Toggle view mode (Ctrl+Shift+M)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ViewModeIcon"
                                           Text="Aa"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource App.Accent}"/>
                                <TextBlock x:Name="ViewModeText"
                                           Text="Formatted"
                                           FontSize="12"
                                           Foreground="{DynamicResource App.TextSecondary}"/>
                            </StackPanel>
                        </Button>

                        <!-- Caret position -->
                        <Button x:Name="LineColButton"
                                Style="{StaticResource StatusChipButtonStyle}"
                                Click="LineColButton_Click"
                                ToolTip="Jump to line (Ctrl+G)">
                            <TextBlock x:Name="LineColText"
                                       Text="Ln 1, Col 1"
                                       FontSize="12"
                                       Foreground="{DynamicResource App.TextSecondary}"/>
                        </Button>

                        <!-- Word count (hover for characters + reading time) -->
                        <Border Padding="9,3" Margin="0,0,6,0" Background="Transparent">
                            <TextBlock x:Name="WordCountText"
                                       Text="0 words"
                                       FontSize="12"
                                       Foreground="{DynamicResource App.TextSecondary}"
                                       VerticalAlignment="Center"
                                       ToolTip="Word count"/>
                        </Border>

                        <!-- Unsaved indicator -->
                        <Border x:Name="SaveStateIndicator"
                                Style="{StaticResource StatusFlagChipStyle}"
                                Visibility="Collapsed"
                                ToolTip="This note has unsaved changes">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6"
                                         Fill="{DynamicResource App.Accent}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <TextBlock Text="Unsaved"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Accent}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StatusBarItem>

                <!-- Right: feature flags, zoom, theme -->
                <StatusBarItem HorizontalAlignment="Right" Padding="0">
                    <StackPanel Orientation="Horizontal">

                        <!-- Feature indicator chips -->
                        <Border x:Name="SpellCheckIndicator"
                                Style="{StaticResource StatusFlagChipStyle}"
                                ToolTip="Spell check enabled"
                                Visibility="Collapsed">
                            <TextBlock Text="SPELL" Style="{StaticResource StatusFlagTextStyle}"/>
                        </Border>
                        <Border x:Name="BionicIndicator"
                                Style="{StaticResource StatusFlagChipStyle}"
                                ToolTip="Bionic reading enabled"
                                Visibility="Collapsed">
                            <TextBlock Text="FOCUS" Style="{StaticResource StatusFlagTextStyle}"/>
                        </Border>
                        <Border x:Name="SplitViewIndicator"
                                Style="{StaticResource StatusFlagChipStyle}"
                                ToolTip="Split view active"
                                Visibility="Collapsed">
                            <TextBlock Text="SPLIT" Style="{StaticResource StatusFlagTextStyle}"/>
                        </Border>

                        <!-- Zoom cluster: one segmented pill, matching the toolbar groups -->
                        <Border Background="{DynamicResource App.Surface2}"
                                BorderBrush="{DynamicResource App.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2"
                                Margin="6,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ZoomOutButton"
                                        Style="{StaticResource StatusChipButtonStyle}"
                                        Padding="7,1"
                                        Margin="0"
                                        Click="ZoomOut_Click"
                                        ToolTip="Zoom out (Ctrl+Minus)">
                                    <TextBlock Text="&#x2212;"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.IconSecondary}"/>
                                </Button>
                                <Button Style="{StaticResource StatusChipButtonStyle}"
                                        Padding="4,1"
                                        Margin="0"
                                        Click="ZoomReset_Click"
                                        ToolTip="Reset zoom (Ctrl+0)">
                                    <TextBlock x:Name="ZoomText"
                                               Text="100%"
                                               FontSize="12"
                                               MinWidth="34"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource App.TextSecondary}"/>
                                </Button>
                                <Button x:Name="ZoomInButton"
                                        Style="{StaticResource StatusChipButtonStyle}"
                                        Padding="7,1"
                                        Margin="0"
                                        Click="ZoomIn_Click"
                                        ToolTip="Zoom in (Ctrl+Plus)">
                                    <TextBlock Text="+"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.IconSecondary}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Theme toggle -->
                        <Button x:Name="ThemeToggle"
                                Style="{StaticResource StatusChipButtonStyle}"
                                Padding="7,2"
                                Margin="0"
                                Click="ToggleTheme_Click"
                                ToolTip="Toggle light / dark theme">
                            <TextBlock Text="&#x25D0;"
                                       FontSize="15"
                                       Foreground="{DynamicResource App.IconSecondary}"/>
                        </Button>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Border>
</Window>
