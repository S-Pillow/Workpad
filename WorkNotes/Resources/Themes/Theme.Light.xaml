<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         Work Notes — Light theme (2027 palette)

         Mirror of the dark theme's structure: the canvas is the
         quietest surface, chrome sits above it, and the same
         indigo→violet accent carries selection and focus. Paper
         white is reserved for the editor so writing feels like the
         brightest thing on screen.
         ============================================================ -->

    <!-- Elevation ladder -->
    <SolidColorBrush x:Key="App.Background" Color="#F4F5F9"/>
    <SolidColorBrush x:Key="App.Surface" Color="#FCFCFE"/>
    <SolidColorBrush x:Key="App.Surface2" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.Border" Color="#E2E4ED"/>

    <!-- Text -->
    <SolidColorBrush x:Key="App.TextPrimary" Color="#1B1D26"/>
    <SolidColorBrush x:Key="App.TextSecondary" Color="#5C6172"/>
    <SolidColorBrush x:Key="App.TextDisabled" Color="#9BA0B0"/>

    <!-- Accent -->
    <Color x:Key="App.AccentColor">#5B5BD6</Color>
    <Color x:Key="App.AccentColorAlt">#0FA98C</Color>
    <SolidColorBrush x:Key="App.Accent" Color="#5B5BD6"/>
    <SolidColorBrush x:Key="App.AccentAlt" Color="#0FA98C"/>
    <SolidColorBrush x:Key="App.AccentMuted" Color="#9695E8"/>
    <SolidColorBrush x:Key="App.AccentText" Color="#FFFFFF"/>

    <LinearGradientBrush x:Key="App.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B5BD6" Offset="0"/>
        <GradientStop Color="#7C5CE0" Offset="0.55"/>
        <GradientStop Color="#0FA98C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="App.SurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F8F9FC" Offset="1"/>
    </LinearGradientBrush>

    <!-- Interaction states -->
    <SolidColorBrush x:Key="App.Hover" Color="#ECEDF4"/>
    <SolidColorBrush x:Key="App.Pressed" Color="#E0E2EC"/>
    <SolidColorBrush x:Key="App.Selected" Color="#E9E9FC"/>

    <!-- Icons -->
    <SolidColorBrush x:Key="App.IconPrimary" Color="#2A2D38"/>
    <SolidColorBrush x:Key="App.IconSecondary" Color="#666C7D"/>

    <!-- Menu -->
    <SolidColorBrush x:Key="App.MenuBackground" Color="#FCFCFE"/>
    <SolidColorBrush x:Key="App.MenuText" Color="#1B1D26"/>
    <SolidColorBrush x:Key="App.MenuHover" Color="#ECEDF4"/>
    <SolidColorBrush x:Key="App.MenuPressed" Color="#E0E2EC"/>

    <!-- Status bar -->
    <SolidColorBrush x:Key="App.StatusBackground" Color="#F0F1F7"/>
    <SolidColorBrush x:Key="App.StatusText" Color="#5C6172"/>

    <!-- Editor canvas -->
    <SolidColorBrush x:Key="App.EditorBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.EditorForeground" Color="#1B1D26"/>
    <SolidColorBrush x:Key="App.EditorLineNumbersForeground" Color="#A2A7B6"/>
    <SolidColorBrush x:Key="App.EditorSelection" Color="#D8D8FA"/>
    <SolidColorBrush x:Key="App.EditorSelectionBorder" Color="#B9B9F2"/>

    <!-- Form controls -->
    <SolidColorBrush x:Key="App.ControlBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.ControlForeground" Color="#1B1D26"/>
    <SolidColorBrush x:Key="App.ControlBorder" Color="#D8DBE6"/>
    <SolidColorBrush x:Key="App.ControlHoverBackground" Color="#ECEDF4"/>
    <SolidColorBrush x:Key="App.ControlSelectedBackground" Color="#E9E9FC"/>

    <!-- Popups -->
    <SolidColorBrush x:Key="App.PopupBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.PopupBorder" Color="#E2E4ED"/>
    <SolidColorBrush x:Key="App.PopupShadow" Color="#000000"/>
    <sys:Double x:Key="App.PopupShadowOpacity">0.18</sys:Double>

    <!-- Tooltip -->
    <SolidColorBrush x:Key="App.TooltipBackground" Color="#20232F"/>
    <SolidColorBrush x:Key="App.TooltipForeground" Color="#F2F3F8"/>
    <SolidColorBrush x:Key="App.TooltipBorder" Color="#20232F"/>

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="App.ScrollBarTrack" Color="Transparent"/>
    <SolidColorBrush x:Key="App.ScrollBarThumb" Color="#C9CDDA"/>
    <SolidColorBrush x:Key="App.ScrollBarThumbHover" Color="#AEB3C4"/>
    <SolidColorBrush x:Key="App.ScrollBarThumbPressed" Color="#939AAE"/>

    <!-- CheckBox / RadioButton -->
    <SolidColorBrush x:Key="App.CheckBoxBorder" Color="#A9AEBF"/>
    <SolidColorBrush x:Key="App.CheckBoxBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.CheckBoxCheckedBackground" Color="#5B5BD6"/>
    <SolidColorBrush x:Key="App.CheckBoxGlyph" Color="#FFFFFF"/>

    <!-- Title bar / caption buttons -->
    <SolidColorBrush x:Key="App.TitleBarBackground" Color="#FCFCFE"/>
    <SolidColorBrush x:Key="App.TitleBarForeground" Color="#1B1D26"/>
    <SolidColorBrush x:Key="App.TitleBarInactiveForeground" Color="#9BA0B0"/>
    <SolidColorBrush x:Key="App.CaptionButtonHover" Color="#ECEDF4"/>
    <SolidColorBrush x:Key="App.CaptionButtonPressed" Color="#E0E2EC"/>
    <SolidColorBrush x:Key="App.CaptionButtonForeground" Color="#2A2D38"/>
    <SolidColorBrush x:Key="App.CaptionCloseHover" Color="#E5484D"/>
    <SolidColorBrush x:Key="App.CaptionClosePressed" Color="#C13539"/>
    <SolidColorBrush x:Key="App.CaptionCloseForegroundHover" Color="#FFFFFF"/>

</ResourceDictionary>
