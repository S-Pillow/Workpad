<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- Windows 11 Dark Theme - Semantic Color Tokens -->
    
    <!-- Background Colors -->
    <SolidColorBrush x:Key="App.Background" Color="#14151A"/>
    <SolidColorBrush x:Key="App.Surface" Color="#1D1E24"/>
    <SolidColorBrush x:Key="App.Surface2" Color="#25262E"/>
    <SolidColorBrush x:Key="App.Border" Color="#343640"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="App.TextPrimary" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="App.TextSecondary" Color="#B4B5C0"/>
    <SolidColorBrush x:Key="App.TextDisabled" Color="#747681"/>
    
    <!-- Accent Colors (Windows 11 Blue) -->
    <SolidColorBrush x:Key="App.Accent" Color="#9B9CFF"/>
    <SolidColorBrush x:Key="App.AccentText" Color="#111116"/>
    <SolidColorBrush x:Key="App.Hover" Color="#2A2C34"/>
    <SolidColorBrush x:Key="App.Pressed" Color="#343640"/>
    <SolidColorBrush x:Key="App.Selected" Color="#30314D"/>
    
    <!-- Icon Colors -->
    <SolidColorBrush x:Key="App.IconPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.IconSecondary" Color="#B8B8B8"/>
    
    <!-- Menu Specific -->
    <SolidColorBrush x:Key="App.MenuBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="App.MenuText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.MenuHover" Color="#333333"/>
    <SolidColorBrush x:Key="App.MenuPressed" Color="#3D3D3D"/>
    
    <!-- StatusBar Specific -->
    <SolidColorBrush x:Key="App.StatusBackground" Color="#14151A"/>
    <SolidColorBrush x:Key="App.StatusText" Color="#B8B8B8"/>
    
    <!-- Editor Specific -->
    <SolidColorBrush x:Key="App.EditorBackground" Color="#18191F"/>
    <SolidColorBrush x:Key="App.EditorForeground" Color="#ECECF1"/>
    <SolidColorBrush x:Key="App.EditorLineNumbersForeground" Color="#858585"/>
    <SolidColorBrush x:Key="App.EditorSelection" Color="#3A5A78"/>
    <SolidColorBrush x:Key="App.EditorSelectionBorder" Color="#3A5A78"/>
    
    <!-- Controls (ComboBox, TextBox, etc.) -->
    <SolidColorBrush x:Key="App.ControlBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="App.ControlForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="App.ControlBorder" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="App.ControlHoverBackground" Color="#333333"/>
    <SolidColorBrush x:Key="App.ControlSelectedBackground" Color="#2E4A5E"/>
    
    <!-- Popup (ComboBox dropdown, context menus) -->
    <SolidColorBrush x:Key="App.PopupBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="App.PopupBorder" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="App.PopupShadow" Color="#000000"/>
    <sys:Double x:Key="App.PopupShadowOpacity">0.5</sys:Double>

    <!-- ToolTip -->
    <SolidColorBrush x:Key="App.TooltipBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="App.TooltipForeground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="App.TooltipBorder" Color="#3F3F3F"/>

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="App.ScrollBarTrack" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="App.ScrollBarThumb" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="App.ScrollBarThumbHover" Color="#606060"/>
    <SolidColorBrush x:Key="App.ScrollBarThumbPressed" Color="#707070"/>

    <!-- CheckBox / RadioButton indicator -->
    <SolidColorBrush x:Key="App.CheckBoxBorder" Color="#999999"/>
    <SolidColorBrush x:Key="App.CheckBoxBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="App.CheckBoxCheckedBackground" Color="#60CDFF"/>
    <SolidColorBrush x:Key="App.CheckBoxGlyph" Color="#000000"/>

    <!-- Title Bar / Caption Buttons -->
    <SolidColorBrush x:Key="App.TitleBarBackground" Color="#1D1E24"/>
    <SolidColorBrush x:Key="App.TitleBarForeground" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="App.TitleBarInactiveForeground" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="App.CaptionButtonHover" Color="#333333"/>
    <SolidColorBrush x:Key="App.CaptionButtonPressed" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="App.CaptionButtonForeground" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="App.CaptionCloseHover" Color="#C42B1C"/>
    <SolidColorBrush x:Key="App.CaptionClosePressed" Color="#B22A1C"/>
    <SolidColorBrush x:Key="App.CaptionCloseForegroundHover" Color="#FFFFFF"/>

</ResourceDictionary>
