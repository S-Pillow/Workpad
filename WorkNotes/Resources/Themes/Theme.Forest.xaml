<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         Workpad — Forest theme (curated palette, WP-07)

         Green-charcoal canvas with a moss accent: grounded and quiet.
         Structure mirrors Theme.Dark — same semantic tokens.
         ============================================================ -->

    <!-- Elevation ladder -->
    <SolidColorBrush x:Key="App.Background" Color="#0E1410"/>
    <SolidColorBrush x:Key="App.Surface" Color="#151D18"/>
    <SolidColorBrush x:Key="App.Surface2" Color="#1D2620"/>
    <SolidColorBrush x:Key="App.Border" Color="#28332B"/>

    <!-- Text -->
    <SolidColorBrush x:Key="App.TextPrimary" Color="#F0F5F0"/>
    <SolidColorBrush x:Key="App.TextSecondary" Color="#A8B5AA"/>
    <SolidColorBrush x:Key="App.TextDisabled" Color="#677366"/>

    <!-- Accent: moss green primary, sage companion -->
    <Color x:Key="App.AccentColor">#8FB573</Color>
    <Color x:Key="App.AccentColorAlt">#6E9C86</Color>
    <SolidColorBrush x:Key="App.Accent" Color="#8FB573"/>
    <SolidColorBrush x:Key="App.AccentAlt" Color="#6E9C86"/>
    <SolidColorBrush x:Key="App.AccentMuted" Color="#4E5B4A"/>
    <SolidColorBrush x:Key="App.AccentText" Color="#0C110C"/>

    <LinearGradientBrush x:Key="App.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8FB573" Offset="0"/>
        <GradientStop Color="#A9C88F" Offset="0.55"/>
        <GradientStop Color="#6E9C86" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="App.SurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A231D" Offset="0"/>
        <GradientStop Color="#151D18" Offset="1"/>
    </LinearGradientBrush>

    <!-- Interaction states -->
    <SolidColorBrush x:Key="App.Hover" Color="#212B24"/>
    <SolidColorBrush x:Key="App.Pressed" Color="#2A352D"/>
    <SolidColorBrush x:Key="App.Selected" Color="#26351F"/>

    <!-- Icons -->
    <SolidColorBrush x:Key="App.IconPrimary" Color="#E9F0E8"/>
    <SolidColorBrush x:Key="App.IconSecondary" Color="#9AA898"/>

    <!-- Menu -->
    <SolidColorBrush x:Key="App.MenuBackground" Color="#151D18"/>
    <SolidColorBrush x:Key="App.MenuText" Color="#E9F0E8"/>
    <SolidColorBrush x:Key="App.MenuHover" Color="#212B24"/>
    <SolidColorBrush x:Key="App.MenuPressed" Color="#2A352D"/>

    <!-- Status bar -->
    <SolidColorBrush x:Key="App.StatusBackground" Color="#121A14"/>
    <SolidColorBrush x:Key="App.StatusText" Color="#A8B5AA"/>

    <!-- Editor canvas -->
    <SolidColorBrush x:Key="App.EditorBackground" Color="#0E1410"/>
    <SolidColorBrush x:Key="App.EditorForeground" Color="#E9F0E8"/>
    <SolidColorBrush x:Key="App.EditorLineNumbersForeground" Color="#52604F"/>
    <SolidColorBrush x:Key="App.EditorSelection" Color="#2F4028"/>
    <SolidColorBrush x:Key="App.EditorSelectionBorder" Color="#4A6B3A"/>

    <!-- Form controls -->
    <SolidColorBrush x:Key="App.ControlBackground" Color="#1A241D"/>
    <SolidColorBrush x:Key="App.ControlForeground" Color="#F0F5F0"/>
    <SolidColorBrush x:Key="App.ControlBorder" Color="#323E33"/>
    <SolidColorBrush x:Key="App.ControlHoverBackground" Color="#212B24"/>
    <SolidColorBrush x:Key="App.ControlSelectedBackground" Color="#26351F"/>

    <!-- Popups -->
    <SolidColorBrush x:Key="App.PopupBackground" Color="#1A241D"/>
    <SolidColorBrush x:Key="App.PopupBorder" Color="#323E33"/>
    <SolidColorBrush x:Key="App.PopupShadow" Color="#000000"/>
    <sys:Double x:Key="App.PopupShadowOpacity">0.55</sys:Double>

    <!-- Tooltip -->
    <SolidColorBrush x:Key="App.TooltipBackground" Color="#1D2620"/>
    <SolidColorBrush x:Key="App.TooltipForeground" Color="#E9F0E8"/>
    <SolidColorBrush x:Key="App.TooltipBorder" Color="#37402F"/>

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="App.ScrollBarTrack" Color="Transparent"/>
    <SolidColorBrush x:Key="App.ScrollBarThumb" Color="#343D34"/>
    <SolidColorBrush x:Key="App.ScrollBarThumbHover" Color="#44513F"/>
    <SolidColorBrush x:Key="App.ScrollBarThumbPressed" Color="#586752"/>

    <!-- CheckBox / RadioButton -->
    <SolidColorBrush x:Key="App.CheckBoxBorder" Color="#56604F"/>
    <SolidColorBrush x:Key="App.CheckBoxBackground" Color="#1A241D"/>
    <SolidColorBrush x:Key="App.CheckBoxCheckedBackground" Color="#8FB573"/>
    <SolidColorBrush x:Key="App.CheckBoxGlyph" Color="#0C110C"/>

    <!-- Title bar / caption buttons -->
    <SolidColorBrush x:Key="App.TitleBarBackground" Color="#151D18"/>
    <SolidColorBrush x:Key="App.TitleBarForeground" Color="#E9F0E8"/>
    <SolidColorBrush x:Key="App.TitleBarInactiveForeground" Color="#677366"/>
    <SolidColorBrush x:Key="App.CaptionButtonHover" Color="#212B24"/>
    <SolidColorBrush x:Key="App.CaptionButtonPressed" Color="#2A352D"/>
    <SolidColorBrush x:Key="App.CaptionButtonForeground" Color="#BECAB9"/>
    <SolidColorBrush x:Key="App.CaptionCloseHover" Color="#E5484D"/>
    <SolidColorBrush x:Key="App.CaptionClosePressed" Color="#C13539"/>
    <SolidColorBrush x:Key="App.CaptionCloseForegroundHover" Color="#FFFFFF"/>

</ResourceDictionary>
