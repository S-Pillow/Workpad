<Window x:Class="WorkNotes.Dialogs.GoToLineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to line"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Go to line"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="22"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="RangeText"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource App.TextSecondary}"/>
        </StackPanel>

        <TextBox x:Name="LineNumberTextBox"
                 Grid.Row="1"
                 Margin="0,18,0,20"
                 MinHeight="40"
                 VerticalContentAlignment="Center"
                 PreviewTextInput="LineNumberTextBox_PreviewTextInput"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0"/>
            <Button Content="Go"
                    IsDefault="True"
                    MinWidth="88"
                    Background="{DynamicResource App.Accent}"
                    Foreground="{DynamicResource App.AccentText}"
                    Click="Go_Click"/>
        </StackPanel>
    </Grid>
</Window>
